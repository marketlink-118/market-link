# ==============================================================================
# MarketLink - Git Ignore Configuration
# TechWiz 7: End-to-End Web Solutions
# ==============================================================================

# Environment and Secrets (CRITICAL: Never commit to Git)
.env
.env.*
*.env
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!**/.env.example
!backend/.env.example
!frontend/.env.example

# Credentials, Certificates & Private Keys
auth.json
*.pem
*.key
*.cert
*.pfx
*.keystore
id_rsa*
*.id_rsa
secrets.*

# Dependencies
node_modules/
frontend/node_modules/
backend/vendor/
vendor/

# Build Outputs & Cache
dist/
frontend/dist/
frontend/build/
backend/public/build/
backend/public/hot/
backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*

# Archive Files
*.zip
*.rar
*.tar.gz

# System, OS & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
